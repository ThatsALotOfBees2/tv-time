{
  "manifest_version": 2,
  "name": "TV Time helper",
  "version": "1.0",
  "description": "Start page, pop-up / click-trap guard and remote-control bridge for the TV Time Android app.",
  "browser_specific_settings": { "gecko": { "id": "tvtime@tvtime.app" } },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js", "bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
